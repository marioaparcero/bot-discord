{
  "name": "owgalaxy-bot",
  "version": "0.1.0",
  "description": "Discord bot para OW Galaxy",
  "main": "dist/index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "swc src -d dist",
    "lint": "biome lint src/*",
    "format": "biome format src/* --write",
    "serve:dev": "tsx ./src/index.ts"
  },
  "keywords": [
    "bot",
    "discord",
    "overwatch",
    "galaxy"
  ],
  "author": "Overwatch Galaxy",
  "license": "MIT",
  "engines": {
    "node": ">=16.6.0",
    "pnpm": ">=6.0.0"
  },
  "contributors": [
    "glitchedslimy",
    "marioaparcero",
    "AJuarez10",
    "Raleth"
  ],
  "devDependencies": {
    "@biomejs/biome": "1.6.3",
    "@swc/cli": "^0.3.12",
    "@swc/core": "^1.4.11",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  }
}