<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Permisos de <%= role.name %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="header flex">
            <h1>Permisos de <%= role.name %> en Canales</h1>
            <a href="/guild/<%= role.guild.id %>" class="btn">Volver al servidor</a>
        </div>

        <!-- Buscador -->
        <div class="card">
            <input type="text" id="searchInput" placeholder="Buscar canales..." class="search-input">
        </div>

        <!-- Grid de canales -->
        <div class="grid" id="channelsContainer">
            <% channels.forEach(channel => { %>
                <div class="card channel-card" data-channel-name="<%= channel.name.toLowerCase() %>">
                    <h3><%= channel.name %></h3>
                    <form action="/guild/<%= role.guild.id %>/role/<%= role.id %>/update" method="POST" class="permissions-form">
                        <input type="hidden" name="channelId" value="<%= channel.id %>">
                        
                        <div class="permission-section">
                            <h4>Permisos Permitidos</h4>
                            <div class="checkbox-group">
                                <% permissions.forEach(perm => { %>
                                    <label class="checkbox-label">
                                        <input type="checkbox" name="allow" value="<%= perm.name %>" 
                                            <% if (channel.allow && channel.allow.includes(perm.name)) { %>checked<% } %>>
                                        <span><%= perm.displayName %></span>
                                    </label>
                                <% }); %>
                            </div>
                        </div>

                        <div class="permission-section">
                            <h4>Permisos Denegados</h4>
                            <div class="checkbox-group">
                                <% permissions.forEach(perm => { %>
                                    <label class="checkbox-label">
                                        <input type="checkbox" name="deny" value="<%= perm.name %>" 
                                            <% if (channel.deny && channel.deny.includes(perm.name)) { %>checked<% } %>>
                                        <span><%= perm.displayName %></span>
                                    </label>
                                <% }); %>
                            </div>
                        </div>

                        <button type="submit" class="btn">Guardar Permisos</button>
                    </form>
                </div>
            <% }); %>
        </div>
    </div>

    <script>
        const searchInput = document.getElementById('searchInput');
        const channelsContainer = document.getElementById('channelsContainer');
        const channelCards = document.querySelectorAll('.channel-card');

        searchInput.addEventListener('input', (e) => {
            const searchTerm = e.target.value.toLowerCase();
            
            channelCards.forEach(card => {
                const channelName = card.getAttribute('data-channel-name');
                if (channelName.includes(searchTerm)) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    </script>
</body>
</html>