<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Permisos de <%= role.name %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <div class="header flex">
            <h1>Permisos de <%= role.name %> en Canales</h1>
            <a href="/guild/<%= role.guild.id %>" class="btn">Volver al servidor</a>
        </div>
        <div class="grid">
            <% channels.forEach(channel => { %>
                <div class="card">
                    <h3><%= channel.name %></h3>
                    <p><strong>Permitidos:</strong> <%= channel.permissions.join(', ') || 'Ninguno' %></p>
                    <p><strong>Denegados:</strong> <%= channel.denied.join(', ') || 'Ninguno' %></p>
                    <form action="/guild/<%= role.guild.id %>/role/<%= role.id %>/update" method="POST">
                        <input type="hidden" name="channelId" value="<%= channel.id %>">
                        <label>Permitir (separados por coma):</label>
                        <input type="text" name="allow" value="<%= channel.permissions.join(',') %>">
                        <label>Denegar (separados por coma):</label>
                        <input type="text" name="deny" value="<%= channel.denied.join(',') %>">
                        <button type="submit">Actualizar</button>
                    </form>
                </div>
            <% }); %>
        </div>
    </div>
</body>
</html>